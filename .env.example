# ============================================================
# ATS Discord System — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to git — it is already gitignored.
# ============================================================

# --- Database ---
POSTGRES_USER=ats
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=ats
DATABASE_URL=postgresql+asyncpg://ats:changeme_strong_password@db:5432/ats

# --- Authentication ---
# Generate JWT secret with: openssl rand -hex 32
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Your login credentials for the dashboard
AUTH_EMAIL=you@example.com
# Generate bcrypt hash with:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=$2b$12$REPLACE_THIS_WITH_YOUR_BCRYPT_HASH

# --- Ollama (self-hosted LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Fast model for job scoring and resume rating (smaller = faster)
OLLAMA_SCORING_MODEL=llama3.2:3b
# Timeout in seconds (tailoring can take 30-90s)
OLLAMA_TIMEOUT=90

# --- Job Scrapers ---
# Adzuna: register free at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# SimplifyJobs new grad listings (community maintained, no auth needed)
SIMPLIFY_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json

# --- Discord ---
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK

# --- Frontend ---
# URL your browser uses to reach the API (without trailing slash)
# Local dev: http://localhost:8000
# Production: https://ats.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Caddy / Domain (production only) ---
DOMAIN=ats.yourdomain.com
ACME_EMAIL=you@example.com

# --- Application Behavior ---
SCRAPE_INTERVAL_MINUTES=60
RELEVANCE_SCORE_THRESHOLD=0.65
UPLOAD_DIR=/app/uploads
LOG_LEVEL=INFO
